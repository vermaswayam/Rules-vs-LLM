# Create a free-tier key in Google AI Studio, then copy this file to .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Explicit paid-price assumptions for projections, not the free-tier invoice.
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
GEMINI_REQUEST_INTERVAL_SECONDS=6
